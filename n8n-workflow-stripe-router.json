    {
      "id": "1",
      "name": "Stripe Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-course-stripe",
        "responseMode": "onReceived",
        "options": {
          "rawBody": true
        }
      }
    },
    {
      "id": "2",
      "name": "Verify Stripe Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst incoming = $input.first();\nconst rawBody = incoming.json.body || incoming.binary?.data || incoming.body;\nconst headers = incoming.json.headers || {};\nconst sig = headers['stripe-signature'] || headers['Stripe-Signature'];\nconst secret = process.env.STRIPE_WEBHOOK_SECRET;\nif (!secret) throw new Error('Missing STRIPE_WEBHOOK_SECRET');\nif (!sig) throw new Error('Missing stripe-signature header');\nif (typeof rawBody !== 'string') throw new Error('Raw body not preserved. Enable Raw Body on the Webhook node.');\nconst sigParts = Object.fromEntries(sig.split(',').map(part => part.split('=')));\nconst timestamp = sigParts.t;\nconst receivedSig = sigParts.v1;\nif (!timestamp || !receivedSig) throw new Error('Malformed stripe-signature header');\nconst toleranceSec = 300;\nconst age = Math.floor(Date.now() / 1000) - parseInt(timestamp, 10);\nif (age > toleranceSec) throw new Error(`Webhook too old: ${age}s`);\nconst signedPayload = `${timestamp}.${rawBody}`;\nconst expectedSig = crypto.createHmac('sha256', secret).update(signedPayload, 'utf8').digest('hex');\nif (expectedSig !== receivedSig) throw new Error('Stripe signature mismatch');\nconst event = JSON.parse(rawBody);\nreturn [{ json: event }];"
      }
    },
    {
      "id": "3",
      "name": "Extract Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const event = $input.first().json;\nconst eventType = event.type;\nconst TIER_TAG_MAP = {\n  core: 'course-core-purchased',\n  launch_system: 'course-launch-system-purchased',\n  membership: 'course-membership-active'\n};\nconst PRICE_ID_MAP = {\n  'price_REPLACE_WITH_CORE_PRICE_ID': 'core',\n  'price_REPLACE_WITH_LAUNCH_PRICE_ID': 'launch_system',\n  'price_REPLACE_WITH_MEMBERSHIP_PRICE_ID': 'membership'\n};\nif (eventType === 'checkout.session.completed') {\n  const session = event.data.object;\n  let tier = session.metadata?.tier || null;\n  if (!tier && session.metadata?.price_id && PRICE_ID_MAP[session.metadata.price_id]) {\n    tier = PRICE_ID_MAP[session.metadata.price_id];\n  }\n  if (!tier) tier = 'unknown';\n  const tag = TIER_TAG_MAP[tier] || null;\n  if (!tag) {\n    throw new Error(`Unknown tier \"${tier}\" for session ${session.id}`);\n  }\n  return [{\n    json: {\n      eventType,\n      email: session.customer_details?.email || session.customer_email || '',\n      name: session.customer_details?.name || '',\n      phone: session.customer_details?.phone || '',\n      tier,\n      tag,\n      stripeCustomerId: session.customer || '',\n      stripeSessionId: session.id,\n      amountPaid: session.amount_total || 0,\n      purchaseDate: new Date().toISOString().slice(0, 10)\n    }\n  }];\n}\nif (eventType === 'customer.subscription.deleted' || eventType === 'invoice.payment_failed') {\n  const obj = event.data.object;\n  return [{\n    json: {\n      eventType,\n      stripeCustomerId: obj.customer || '',\n      subscriptionId: obj.id || obj.subscription || ''\n    }\n  }];\n}\nreturn [{ json: { eventType, raw: event } }];"
      }
    },
    {
      "id": "4",
      "name": "Route Event",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [960, 300],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{$json.eventType}}",
                    "rightValue": "checkout.session.completed",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "checkout_completed"
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{$json.eventType}}",
                    "rightValue": "customer.subscription.deleted",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "subscription_deleted"
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{$json.eventType}}",
                    "rightValue": "invoice.payment_failed",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "invoice_failed"
            }
          ]
        },
        "fallbackOutput": "none"
      }
    },
